# ==============================================================================
# MoneyMoney — Multi-Asset Family Wealth Vault (Frontend Environment Variables)
# ==============================================================================
# Copy this file to .env or .env.local to configure your custom environment.
# When running in standalone demo mode without a backend, all variables are optional.

# --- Firebase Live Sync & Authentication ---
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-family-vault.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-family-vault
VITE_FIREBASE_STORAGE_BUCKET=your-family-vault.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIRESTORE_VAULT_DOC=default_family

# --- Access Control Whitelist (Comma-separated) ---
# Set to '*' to allow any Google account, or specify approved family email addresses.
VITE_ALLOWED_FAMILY_EMAILS=alex.taylor@example.com,robert.taylor@example.com,margaret.taylor@example.com

# --- Multimodal Voice & AI Concierge ---
VITE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- FastAPI Backend Ingestion API URL ---
VITE_API_BASE_URL=http://localhost:8000
